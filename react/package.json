{
  "name": "timeline-rail-react",
  "version": "0.1.0",
  "description": "TimelineRail as a React component: a vertical, collapsible timeline.",
  "type": "module",
  "main": "dist/timeline-rail-react.js",
  "module": "dist/timeline-rail-react.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/timeline-rail-react.js" },
    "./style.css": "./dist/style.css",
    "./theme.css": "./src/theme.css"
  },
  "files": ["dist", "src/theme.css"],
  "scripts": {
    "sync": "python3 ../tools/sync_css.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "license": "CC-BY-SA-4.0"
}
